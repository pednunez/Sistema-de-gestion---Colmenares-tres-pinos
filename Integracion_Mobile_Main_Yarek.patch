+      );
+
+      return false;
+    }
+
+    return true;
+  };
+
+  // ========================================
+  // GUARDAR MOVIMIENTO
+  // ========================================
+
+  const guardarMovimiento = async () => {
+
+    if (!validarMovimiento()) {
+      return;
+    }
+
+    setGuardando(true);
+
+    try {
+
+      const token = await obtenerToken();
+
+      const datos: StockMovimientoCreate = {
+        material: materialSeleccionado,
+        tipo: tipoMovimiento,
+        cantidad: Number(cantidad),
