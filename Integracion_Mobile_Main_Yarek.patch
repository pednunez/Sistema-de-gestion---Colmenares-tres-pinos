+
+            <Text style={styles.resumenTexto}>
+              Disponibles
+            </Text>
+
+          </View>
+
+          <View style={styles.resumenCard}>
+
+            <Text style={[
+              styles.numero,
+              styles.rojo,
+            ]}>
+              {totales.danado}
+            </Text>
+
+            <Text style={styles.resumenTexto}>
+              Dañados
+            </Text>
+
+          </View>
+
+          <View style={styles.resumenCard}>
+
+            <Text style={[
+              styles.numero,
+              styles.naranja,
+            ]}>
+              {totales.reparacion}
+            </Text>
+
+            <Text style={styles.resumenTexto}>
+              En reparación
+            </Text>
+
+          </View>
+
+          <View style={styles.resumenCard}>
+
+            <Text style={[
+              styles.numero,
+              styles.gris,
+            ]}>
+              {totales.merma}
+            </Text>
+
+            <Text style={styles.resumenTexto}>
+              Merma
+            </Text>
+
+          </View>
+
+        </View>
+
+        {/* ALERTAS */}
+
+        {materialesBajos.length > 0 && (
+
+          <View style={styles.alerta}>
+
+            <Text style={styles.alertaTitulo}>
+              ⚠ Stock bajo
+            </Text>
+
+            {materialesBajos.map(item => (
+
