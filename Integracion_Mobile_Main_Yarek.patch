+    {
+      method: 'POST',
+      token,
+      body: datos,
+    }
+  );
+}
+
+// ==========================================
+// ACTUALIZAR USUARIO
+// PATCH /usuarios/{usuario_id}
+// ==========================================
+
+export async function actualizarUsuario(
+  token: string,
+  usuarioId: number,
+  datos: UsuarioActualizar
+): Promise<UsuarioAPI> {
+  return solicitarAPI<UsuarioAPI>(
+    `/usuarios/${usuarioId}`,
+    {
+      method: 'PATCH',
+      token,
+      body: datos,
+    }
+  );
+}
+
+// ==========================================
+// DESACTIVAR USUARIO
+// DELETE /usuarios/{usuario_id}
+// BAJA LOGICA
+// ==========================================
+
+export async function desactivarUsuario(
+  token: string,
+  usuarioId: number
+): Promise<void> {
+  await solicitarAPI<unknown>(
+    `/usuarios/${usuarioId}`,
+    {
+      method: 'DELETE',
+      token,
+    }
+  );
+}
