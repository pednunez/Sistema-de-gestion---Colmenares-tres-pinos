+
+    } catch (err) {
+
+      Alert.alert(
+        'No se pudo actualizar',
+        obtenerMensaje(err)
+      );
+
+    } finally {
+
+      setGuardando(false);
+
+    }
+  };
+
+  // ========================================
+  // CERRAR MODAL
+  // ========================================
+
+  const cerrarModal = () => {
+
+    if (guardando) {
+      return;
+    }
+
+    setModal(null);
+  };
+
+  // ========================================
+  // APLICAR FILTROS DEL HISTORIAL
+  // ========================================
+
+  const aplicarFiltros = () => {
+
+    const desde = filtroDesde.trim();
+    const hasta = filtroHasta.trim();
+
+    if (
+      !validarFecha(desde) ||
+      !validarFecha(hasta)
+    ) {
+
+      Alert.alert(
+        'Fecha inválida',
+        'Utiliza el formato AAAA-MM-DD.'
+      );
+
+      return;
+    }
+
+    if (
+      desde &&
+      hasta &&
+      desde > hasta
+    ) {
+
+      Alert.alert(
+        'Rango inválido',
+        'La fecha inicial no puede ser posterior a la fecha final.'
+      );
+
+      return;
+    }
+
+    const filtros: FiltrosHistorialStock = {
+
+      material:
+        filtroMaterial || undefined,
+
+      tipo:
+        filtroTipo || undefined,
+
+      desde:
+        desde || undefined,
+
+      hasta:
+        hasta || undefined,
+
+    };
+
+    setFiltrosAplicados(filtros);
+
+    void cargarHistorial(1, filtros);
+  };
+
+  // ========================================
+  // LIMPIAR FILTROS
+  // ========================================
+
+  const limpiarFiltros = () => {
+
+    setFiltroMaterial('');
