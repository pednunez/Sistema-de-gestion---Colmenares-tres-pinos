+    }
+
+    if (sesion.usuario.rol !== 'ADMIN') {
+      return;
+    }
+
+    await cargarRegistros(
+      sesion.accessToken,
+      true
+    );
+
+  };
+
+  // ========================================
+  // CONSULTAR DETALLE
+  // GET /auditoria/{id}
+  // ========================================
+
+  const abrirDetalle = async (
+    registro: AuditoriaRegistro
+  ) => {
+
+    if (!sesion) {
+      return;
+    }
+
+    setSeleccionado(registro);
+    setDetalleError(null);
+    setDetalleCargando(true);
+
+    try {
+
+      const detalle =
+        await solicitarAPI<AuditoriaRegistro>(
+          `/auditoria/${registro.id}`,
+          {
+            token: sesion.accessToken,
+          }
+        );
+
+      setSeleccionado(detalle);
+
+    } catch (e) {
+
+      setDetalleError(
+        e instanceof Error
+          ? e.message
+          : 'No fue posible consultar el detalle.'
+      );
+
+    } finally {
+
+      setDetalleCargando(false);
+
+    }
+
+  };
+
+  // ========================================
+  // FILTRAR REGISTROS
+  // ========================================
+
+  const registrosFiltrados = useMemo(() => {
+
+    const texto = busqueda
+      .trim()
+      .toLowerCase();
+
+    return registros.filter((registro) => {
+
+      const coincideAccion =
+        filtroAccion === 'TODAS' ||
+        registro.accion === filtroAccion;
+
+      const contenido = [
+        registro.id,
+        registro.entidad,
+        registro.entidad_id,
+        registro.usuario_id,
+      ]
+        .join(' ')
+        .toLowerCase();
+
+      const coincideBusqueda =
+        !texto || contenido.includes(texto);
+
+      return coincideAccion && coincideBusqueda;
+
+    });
+
+  }, [registros, filtroAccion, busqueda]);
+
+  // ========================================
+  // ESTADÍSTICAS
+  // ========================================
+
+  const total = registros.length;
+
+  const creados = registros.filter(
+    (r) => r.accion === 'CREAR'
