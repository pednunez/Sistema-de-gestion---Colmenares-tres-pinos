+
+          setHistorialError(
+            obtenerMensaje(err)
+          );
+
+        }
+
+      } finally {
+
+        setHistorialCargando(false);
+
+      }
+    },
+    []
+  );
+
+  // ========================================
+  // CARGA INICIAL
+  // ========================================
+
+  useEffect(() => {
+
+    void cargarStock(true);
+
+    void cargarHistorial(1, {});
+
+  }, [
+    cargarStock,
+    cargarHistorial,
+  ]);
+
+  // ========================================
+  // ACTUALIZAR PANTALLA
+  // ========================================
+
+  const recargarTodo = () => {
+
+    void cargarStock(false);
+
+    void cargarHistorial(
+      pagina,
+      filtrosAplicados
+    );
+  };
+
+  // ========================================
+  // FILTRAR INVENTARIO
+  // ========================================
+
