+
+  const eliminados = registros.filter(
+    (r) => r.accion === 'ELIMINAR'
+  ).length;
+
+  const restaurados = registros.filter(
+    (r) => r.accion === 'RESTAURAR'
+  ).length;
+
+  // ========================================
+  // RENDERIZAR COMPARACIÓN DE DATOS
+  // ========================================
+
+  const renderDatos = (
