+import {
+  leerSesionGuardada,
+} from './api/auth';
+
+import type {
+  SesionMovil,
+} from './api/auth';
+
+import {
+  solicitarAPI,
+} from './api/cliente';
+
+// ==========================================
+// TIPOS
+// ==========================================
+
+type AccionAuditoria =
+  | 'CREAR'
+  | 'MODIFICAR'
+  | 'ELIMINAR'
+  | 'RESTAURAR';
+
+type FiltroAccion =
+  | 'TODAS'
+  | AccionAuditoria;
+
+type AuditoriaRegistro = {
+  id: number;
+  fecha: string;
+  usuario_id: number | null;
+  entidad: string;
+  entidad_id: number | null;
+  accion: AccionAuditoria;
+  datos_anteriores: Record<string, unknown> | null;
+  datos_nuevos: Record<string, unknown> | null;
+};
+
+type Props = {
+  onVolver: () => void;
+};
+
+// ==========================================
+// CONSTANTES
+// ==========================================
+
+const FILTROS: FiltroAccion[] = [
+  'TODAS',
+  'CREAR',
+  'MODIFICAR',
+  'ELIMINAR',
+  'RESTAURAR',
+];
+
+const COLORES: Record<
+  AccionAuditoria,
+  { fondo: string; texto: string }
+> = {
+  CREAR: {
+    fondo: '#DCFCE7',
+    texto: '#15803D',
+  },
+  MODIFICAR: {
+    fondo: '#DBEAFE',
+    texto: '#1D4ED8',
+  },
+  ELIMINAR: {
+    fondo: '#FEE2E2',
+    texto: '#B91C1C',
+  },
+  RESTAURAR: {
+    fondo: '#FEF3C7',
+    texto: '#B45309',
+  },
+};
+
+// ==========================================
+// UTILIDADES
+// ==========================================
+
+function formatearFecha(fecha: string): string {
+  const valor = new Date(fecha);
+
+  if (Number.isNaN(valor.getTime())) {
+    return fecha;
+  }
+
+  return valor.toLocaleString('es-CL', {
+    day: '2-digit',
+    month: 'short',
+    year: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+}
+
+function formatearValor(valor: unknown): string {
+  if (valor === null || valor === undefined) {
+    return 'Sin información';
+  }
+
+  if (typeof valor === 'object') {
+    return JSON.stringify(valor, null, 2) ?? '';
+  }
+
+  if (typeof valor === 'boolean') {
+    return valor ? 'Sí' : 'No';
+  }
+
+  return String(valor);
+}
+
+// ==========================================
+// COMPONENTE PRINCIPAL
+// ==========================================
+
+export default function AuditoriaLocales({
+  onVolver,
+}: Props) {
+
+  const [sesion, setSesion] =
+    useState<SesionMovil | null>(null);
+
+  const [registros, setRegistros] =
+    useState<AuditoriaRegistro[]>([]);
+
+  const [cargando, setCargando] =
+    useState(true);
+
+  const [actualizando, setActualizando] =
+    useState(false);
+
+  const [error, setError] =
+    useState<string | null>(null);
+
+  const [busqueda, setBusqueda] =
+    useState('');
+
+  const [filtroAccion, setFiltroAccion] =
+    useState<FiltroAccion>('TODAS');
+
+  const [seleccionado, setSeleccionado] =
+    useState<AuditoriaRegistro | null>(null);
+
+  const [detalleCargando, setDetalleCargando] =
+    useState(false);
+
+  const [detalleError, setDetalleError] =
+    useState<string | null>(null);
+
+  // ========================================
+  // CARGAR REGISTROS DESDE FASTAPI
+  // GET /auditoria/
+  // ========================================
+
+  const cargarRegistros = useCallback(
+    async (
+      token: string,
+      refrescar = false,
+    ) => {
+
+      if (refrescar) {
+        setActualizando(true);
+      } else {
+        setCargando(true);
+      }
+
+      setError(null);
+
+      try {
+
+        const respuesta =
+          await solicitarAPI<AuditoriaRegistro[]>(
+            '/auditoria/',
+            {
+              token,
+            }
+          );
+
+        if (!Array.isArray(respuesta)) {
+          throw new Error(
+            'El servidor devolvió un listado inválido.'
+          );
+        }
+
+        setRegistros(respuesta);
+
+      } catch (e) {
+
+        setError(
+          e instanceof Error
+            ? e.message
+            : 'No fue posible cargar la auditoría.'
+        );
+
+      } finally {
+
+        setCargando(false);
+        setActualizando(false);
+
+      }
+
+    },
+    []
+  );
+
+  // ========================================
+  // RECUPERAR SESIÓN Y VALIDAR ADMIN
+  // ========================================
+
+  const inicializar = useCallback(
+    async () => {
+
+      setCargando(true);
+      setError(null);
+
+      try {
+
+        const guardada =
+          await leerSesionGuardada();
+
+        if (!guardada) {
+          setError(
+            'No existe una sesión activa. Inicia sesión nuevamente.'
+          );
+
+          return;
+        }
+
+        setSesion(guardada);
+
+        if (guardada.usuario.rol !== 'ADMIN') {
+          setError(
+            'No tienes permisos para consultar Auditoría.'
+          );
+
+          return;
+        }
+
+        await cargarRegistros(
+          guardada.accessToken
+        );
+
+      } catch (e) {
+
+        setError(
+          e instanceof Error
+            ? e.message
+            : 'No fue posible iniciar Auditoría.'
+        );
+
+      } finally {
+
+        setCargando(false);
+
+      }
+
+    },
+    [cargarRegistros]
+  );
+
+  useEffect(() => {
+    void inicializar();
+  }, [inicializar]);
+
+  // ========================================
+  // ACTUALIZAR
+  // ========================================
+
+  const actualizar = async () => {
+
+    if (!sesion) {
+      await inicializar();
