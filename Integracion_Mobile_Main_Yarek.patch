+
+  // ----------------------------------------
+  // VALIDAR PROPIETARIO
+  // ----------------------------------------
+
+  if (registro.usuario_local_id !== usuarioId) {
+    throw new Error(
+      'El tratamiento no pertenece al usuario actual.'
+    );
+  }
+
+  // ----------------------------------------
+  // VALIDAR IDENTIFICADOR
+  // ----------------------------------------
+
+  if (!UUID_VALIDO.test(registro.id_cliente)) {
+    throw new Error(
+      'El tratamiento no tiene un UUID válido.'
+    );
+  }
