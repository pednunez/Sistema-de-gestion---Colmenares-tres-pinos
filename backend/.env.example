DB_USER=TU_USUARIO_POSTGRESQL
DB_PASSWORD=TU_CONTRASENA
DB_HOST=TU_HOST_POSTGRESQL
DB_PORT=5432
DB_NAME=TU_BASE_DE_DATOS

JWT_SECRET_KEY=TU_CLAVE_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RF-03: correo de recuperacion (completar solo en backend/.env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Colmenares Tres Pinos"
SMTP_USE_TLS=false
SMTP_USE_SSL=true
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/restablecer-password

# Sesion: Secure=true en HTTPS. Solo desarrollo HTTP local: false.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
